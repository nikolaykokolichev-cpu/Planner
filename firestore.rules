rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Всеки потребител чете и пише само собствените си данни.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Мост за външен асистент. {key} е тайният ключ от „Навици → Настройки".
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    function validOp(key, d) {
      return key.size() >= 32 && key.size() <= 128
        && d.keys().hasAll(['op', 'taskId'])
        && d.keys().hasOnly(['op', 'taskId', 'title', 'notes', 'date', 'time', 'cat', 'prio', 'at'])
        && d.op in ['add', 'update', 'done', 'undone', 'delete']
        && d.taskId is string && d.taskId.matches('^[A-Za-z0-9_-]{1,128}$')
        && optStr(d, 'title', 200)
        && optStr(d, 'notes', 2000)
        && (!('date' in d) || (d.date is string && d.date.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')))
        && (!('time' in d) || (d.time is string && d.time.matches('^([0-9]{2}:[0-9]{2})?$')))
        && optStr(d, 'cat', 20)
        && (!('prio' in d) || (d.prio is int && d.prio in [1, 2, 3]))
        && optStr(d, 'at', 40);
    }

    // Входяща кутия: всеки (с ключа) може да пусне операция; само влязъл потребител чете и трие.
    match /bridge/{key}/inbox/{id} {
      allow create: if validOp(key, request.resource.data);
      allow read, delete: if request.auth != null;
    }

    // Огледален статус на задачите „Аспазия": четене за всеки (с ключа), запис само за влязъл.
    match /bridge/{key}/status/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
